<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Explicit base style: dotted style names otherwise infer this parent. -->
    <style name="Text.VoiceDeck" parent="@android:style/TextAppearance.Material" />
    <!-- Dotted style names infer parent styles; define the intermediate Widget chain. -->
    <style name="Widget" parent="@android:style/Widget.Material" />
    <style name="Widget.VoiceDeck" parent="Widget" />
    <style name="Widget.VoiceDeck.Button" parent="@android:style/Widget.Material.Button" />

    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:colorAccent">@color/vd_primary</item>
        <item name="android:statusBarColor">@color/vd_background</item>
        <item name="android:navigationBarColor">@color/vd_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/vd_background</item>
    </style>

    <style name="Text.VoiceDeck.Brand" parent="Text.VoiceDeck">
        <item name="android:textColor">@color/vd_text</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/manrope</item>
    </style>
    <style name="Text.VoiceDeck.Eyebrow" parent="Text.VoiceDeck">
        <item name="android:textColor">@color/vd_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>
    <style name="Text.VoiceDeck.Display" parent="Text.VoiceDeck">
        <item name="android:textColor">@color/vd_text</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">0.95</item>
    </style>
    <style name="Text.VoiceDeck.Title" parent="Text.VoiceDeck">
        <item name="android:textColor">@color/vd_text</item>
        <item name="android:textSize">29sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.VoiceDeck.SectionTitle" parent="Text.VoiceDeck">
        <item name="android:textColor">@color/vd_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.VoiceDeck.Body" parent="Text.VoiceDeck">
        <item name="android:textColor">@color/vd_text_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Text.VoiceDeck.Caption" parent="Text.VoiceDeck">
        <item name="android:textColor">@color/vd_text_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Platform-widget styles: no Material Components dependency required. -->
    <style name="Widget.VoiceDeck.Button.Primary" parent="@android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textColor">@color/vd_white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/space_5</item>
        <item name="android:paddingEnd">@dimen/space_5</item>
        <item name="android:background">@drawable/bg_button_primary</item>
    </style>
    <style name="Widget.VoiceDeck.Button.Outline" parent="@android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">@dimen/button_height_secondary</item>
        <item name="android:textColor">@color/vd_primary_deep</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
        <item name="android:background">@drawable/bg_button_outline</item>
    </style>
    <style name="Widget.VoiceDeck.Button.Text" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textColor">@color/vd_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.VoiceDeck.Field" parent="@android:style/Widget.Material.EditText">
        <item name="android:minHeight">@dimen/field_height</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/vd_text</item>
        <item name="android:textColorHint">@color/vd_text_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vd_canvas">

<LinearLayout
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintWidth_max="@dimen/content_max_width">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/add_alias" style="@style/Text.VoiceDeck.Title" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:text="@string/link_a_familiar_nickname_to_an_existing_contact" style="@style/Text.VoiceDeck.Body" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="@string/nickname" style="@style/Text.VoiceDeck.Eyebrow" />
    <EditText android:id="@+id/alias_nickname" android:layout_width="match_parent" android:layout_height="@dimen/field_height" android:layout_marginTop="@dimen/space_2" android:hint="@string/e_g_saz" android:inputType="textPersonName" style="@style/Widget.VoiceDeck.Field" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_5" android:text="@string/contact" style="@style/Text.VoiceDeck.Eyebrow" />
    <TextView android:id="@+id/alias_contact_selector" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="@dimen/space_2" android:background="@drawable/bg_card" android:gravity="center_vertical" android:paddingHorizontal="@dimen/space_4" android:text="@string/select_contact" android:textColor="@color/vd_text" android:textSize="15sp" android:textStyle="bold" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_5" android:text="@string/language" style="@style/Text.VoiceDeck.Eyebrow" />
    <TextView android:id="@+id/alias_language_selector" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="@dimen/space_2" android:background="@drawable/bg_card" android:gravity="center_vertical" android:paddingHorizontal="@dimen/space_4" android:text="@string/language_english" android:textColor="@color/vd_text" android:textSize="15sp" android:textStyle="bold" />

    <Space android:layout_width="1dp" android:layout_height="28dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:backgroundTint="@null" android:id="@+id/action_cancel_alias" android:layout_width="0dp" android:layout_height="@dimen/button_height" android:layout_marginEnd="@dimen/space_2" android:layout_weight="1" android:text="@string/cancel" style="@style/Widget.VoiceDeck.Button.Outline" />
        <Button android:backgroundTint="@null" android:id="@+id/action_save_alias" android:layout_width="0dp" android:layout_height="@dimen/button_height" android:layout_marginStart="@dimen/space_2" android:layout_weight="1" android:text="@string/save_alias" style="@style/Widget.VoiceDeck.Button.Primary" />
    </LinearLayout>
</LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vd_canvas">

<LinearLayout
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintWidth_max="@dimen/content_max_width">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VOICE SEARCH"
        style="@style/Text.VoiceDeck.Eyebrow" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="I’m listening"
        style="@style/Text.VoiceDeck.Title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="Say the name naturally, just as you know them."
        style="@style/Text.VoiceDeck.Body" />

    <FrameLayout
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/bg_sage_circle">

        <ImageView
            android:id="@+id/listening_mic"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_primary_circle"
            android:contentDescription="Listening"
            android:padding="27dp"
            android:src="@drawable/ic_mic_white" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/waveform"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/space_3"
        android:gravity="center"
        android:orientation="horizontal">

        <View android:layout_width="4dp" android:layout_height="14dp" android:layout_margin="3dp" android:background="@color/vd_primary" />
        <View android:layout_width="4dp" android:layout_height="26dp" android:layout_margin="3dp" android:background="@color/vd_primary" />
        <View android:layout_width="4dp" android:layout_height="36dp" android:layout_margin="3dp" android:background="@color/vd_primary" />
        <View android:layout_width="4dp" android:layout_height="22dp" android:layout_margin="3dp" android:background="@color/vd_primary" />
        <View android:layout_width="4dp" android:layout_height="40dp" android:layout_margin="3dp" android:background="@color/vd_primary" />
        <View android:layout_width="4dp" android:layout_height="28dp" android:layout_margin="3dp" android:background="@color/vd_primary" />
        <View android:layout_width="4dp" android:layout_height="18dp" android:layout_margin="3dp" android:background="@color/vd_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_5">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HEARD SO FAR"
            style="@style/Text.VoiceDeck.Eyebrow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="“Sarah…”"
            android:textColor="@color/vd_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="Keep speaking, or tap stop when you’re done."
            style="@style/Text.VoiceDeck.Caption" />
    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_cancel_listening"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="@dimen/space_2"
            android:layout_weight="1"
            android:text="Cancel"
            style="@style/Widget.VoiceDeck.Button.Outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_stop_listening"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:text="Stop listening"
            style="@style/Widget.VoiceDeck.Button.Primary" />
    </LinearLayout>
</LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

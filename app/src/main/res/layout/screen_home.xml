<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vd_canvas">

<ScrollView
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:fillViewport="true"
    android:clipToPadding="false"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintWidth_max="@dimen/content_max_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="720dp"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_first_contacts"
            style="@style/Text.VoiceDeck.Eyebrow" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/who_would_you_like_to_connect_with"
            style="@style/Text.VoiceDeck.Display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/just_say_a_name_we_ll_find_the_contact_for_you"
            style="@style/Text.VoiceDeck.Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_6">

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_sage_circle"
                android:padding="@dimen/space_5">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_sage_circle"
                    android:contentDescription="@null"
                    android:padding="@dimen/space_5"
                    android:src="@drawable/ic_mic" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/ready_when_you_are"
                style="@style/Text.VoiceDeck.SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center"
                android:text="@string/tap_the_button_below_then_say_a_contact_s_name"
                style="@style/Text.VoiceDeck.Body" />

            <Button android:backgroundTint="@null"
                android:id="@+id/action_speak"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_5"
                android:drawableStart="@drawable/ic_mic_white"
                android:text="@string/tap_to_speak"
                style="@style/Widget.VoiceDeck.Button.Primary" />

            <Button android:backgroundTint="@null"
                android:id="@+id/action_manual_search"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_secondary"
                android:layout_marginTop="@dimen/space_3"
                android:drawableStart="@drawable/ic_keyboard"
                android:text="@string/search_by_typing_instead"
                style="@style/Widget.VoiceDeck.Button.Outline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:drawablePadding="@dimen/space_2"
                android:gravity="center"
                android:text="@string/your_contacts_stay_on_this_phone"
                style="@style/Text.VoiceDeck.Caption" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:gravity="center"
            android:text="@string/your_simple_way_to_reach_the_people_who_matter"
            style="@style/Text.VoiceDeck.Caption" />
    </LinearLayout>
</ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

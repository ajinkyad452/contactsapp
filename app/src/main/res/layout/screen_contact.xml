<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vd_canvas">

<ScrollView
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:clipToPadding="false"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintWidth_max="@dimen/content_max_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/best_match"
                style="@style/Text.VoiceDeck.Eyebrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/here_s_who_i_found"
                style="@style/Text.VoiceDeck.Caption" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/contact_card"
            android:layout_width="match_parent"
            android:layout_height="@dimen/contact_card_height"
            android:layout_marginTop="@dimen/space_3">

            <LinearLayout
                android:id="@+id/contact_front"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="@dimen/space_5">

                <ImageView
                    android:id="@+id/contact_photo"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:background="@color/vd_sage"
                    android:contentDescription="@string/contact_photo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/contact_portrait" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:gravity="center"
                    android:id="@+id/contact_name" android:text=""
                    android:textColor="@color/vd_text"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:gravity="center"
                    android:id="@+id/contact_phone" android:text=""
                    style="@style/Text.VoiceDeck.Body" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_5"
                    android:layout_marginBottom="@dimen/space_5"
                    android:background="@color/vd_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button android:backgroundTint="@null"
                        android:id="@+id/action_call"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginEnd="@dimen/space_2"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_call"
                        android:text="@string/call"
                        style="@style/Widget.VoiceDeck.Button.Primary" />

                    <Button android:backgroundTint="@null"
                        android:id="@+id/action_whatsapp"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginStart="@dimen/space_2"
                        android:drawableStart="@drawable/ic_whatsapp"
                        android:layout_weight="1"
                        android:text="WhatsApp"
                        style="@style/Widget.VoiceDeck.Button.Outline" />
                </LinearLayout>

                <TextView
                    android:id="@+id/action_show_details"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginTop="@dimen/space_3"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/tap_for_email_birthday_and_other_details"
                    style="@style/Text.VoiceDeck.Caption" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contact_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="@dimen/space_5"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/contact_details"
                        style="@style/Text.VoiceDeck.Eyebrow" />
                    <ImageButton
                        android:id="@+id/action_flip_icon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_sage_circle"
                        android:src="@drawable/ic_refresh"
                        android:padding="12dp"
                        android:contentDescription="@string/back_to_card_front" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:id="@+id/contact_back_name" android:text=""
                    android:textColor="@color/vd_text"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_4"
                    android:layout_marginBottom="@dimen/space_3"
                    android:background="@color/vd_border" />

                <LinearLayout
                    android:id="@+id/contact_detail_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/contact_no_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/no_additional_information_saved_for_this_contact"
                    android:textSize="13sp"
                    android:textColor="@color/vd_text_muted"
                    android:visibility="gone" />

                <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

                <Button android:backgroundTint="@null"
                    android:id="@+id/action_google_contacts"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_secondary"
                    android:text="@string/open_in_google_contacts"
                    android:drawableStart="@drawable/ic_contact_external"
                    android:drawablePadding="10dp"
                    style="@style/Widget.VoiceDeck.Button.Outline" />

                <Button android:backgroundTint="@null"
                    android:id="@+id/action_show_front"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_secondary"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/back_to_card_front"
                    android:drawableStart="@drawable/ic_refresh"
                    android:drawablePadding="9dp"
                    style="@style/Widget.VoiceDeck.Button.Text" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center"
            android:orientation="horizontal">

            <Button android:backgroundTint="@null"
                android:id="@+id/action_previous_contact"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="@drawable/bg_sage_circle"
                android:text="‹"
                android:textColor="@color/vd_primary"
                android:textSize="28sp" />

            <ImageButton
                android:id="@+id/action_contact_mic"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="@dimen/space_8"
                android:background="@drawable/bg_primary_circle"
                android:contentDescription="@string/start_another_voice_search"
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_mic_white" />

            <Button android:backgroundTint="@null"
                android:id="@+id/action_next_contact"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="@drawable/bg_sage_circle"
                android:text="›"
                android:textColor="@color/vd_primary"
                android:textSize="28sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:id="@+id/contact_count" android:text=""
            style="@style/Text.VoiceDeck.Caption" />
    </LinearLayout>
</ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
